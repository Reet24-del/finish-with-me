# Set a key from your provider account. Keep this file private; never commit .env.
OPENAI_API_KEY=

# Set this to the initial password you choose for the IRIS container.
IRIS_PASSWORD=ChangeThisPassword
IRIS_USERNAME=_SYSTEM

# Only change this when you retag the AI Hub Community image to another name.
IRIS_IMAGE=iris-community:2027.1.0AI.109.0

AIHUB_PROVIDER=groq

AIHUB_MODEL=openai/gpt-oss-120b

GROQ_API_KEY=

# Hosted visitor workspaces: a private Postgres URL, kept server-side.
# Leave empty for the local disk store. Use SSL for a cloud database.
DATABASE_URL=

# Optional: private Render API key for deployment setup; never expose to React.
RENDER_API_KEY=

# Optional free hosted AI mode. Default/empty keeps native IRIS routing.
AI_BACKEND=
GROQ_MODEL=openai/gpt-oss-120b
