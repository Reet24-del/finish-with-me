# Set a key from your provider account. Keep this file private; never commit .env.
OPENAI_API_KEY=

# Set this to the initial password you choose for the IRIS container.
IRIS_PASSWORD=ChangeThisPassword
IRIS_USERNAME=_SYSTEM

# Only change this when you retag the AI Hub Community image to another name.
IRIS_IMAGE=iris-community:2027.1.0AI.109.0

AIHUB_PROVIDER=groq

AIHUB_MODEL=qwen/qwen3.8-27b

GROQ_API_KEY=
